+_DASH_DEFINITION = re.compile(
+    r"^(?P<term>[A-Z][\w'’/&+.-]*(?:\s+[\w'’/&+.-]+){0,3}(?:\s+\([^()]{1,40}\))?)"
+    r"\s+(?:—|–|--|-)\s+(?P<explanation>[^—–]{12,300})$"
+)
+
+
+_DOCUMENT_PART_WORDS = {
+    "activity", "chapter", "figure", "lecture", "lesson", "module", "page", "part",
+    "section", "step", "table", "topic", "unit", "week",
+}
+
